{
  "name": "color-snap",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scheme": "colorsnap",
  "owner": "openhands",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-camera": "~15.0.0",
    "expo-constants": "~16.0.0",
    "expo-file-system": "~17.0.0",
    "expo-linking": "~6.3.0",
    "expo-media-library": "~16.0.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.0",
    "expo-system-ui": "~3.0.0",
    "jpeg-js": "^0.4.4",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-keyboard-controller": "1.1.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-view-shot": "~3.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.48",
    "babel-plugin-module-resolver": "^5.0.0",
    "jest": "^29.0.0",
    "jest-expo": "~51.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  },
  "private": true
}
